# Copiar este archivo a .env.local para desarrollo local, y cargar las
# mismas variables en Vercel (Project Settings > Environment Variables)
# para produccion.
#
# Sin estas tres variables, el sitio funciona igual pero usa los precios
# de respaldo embebidos en el codigo (src/lib/precios.ts) y no guarda
# leads en ningun lado (solo un warning en el log del server).

# Email de la service account de Google Cloud (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la service account (del JSON descargado), con los \n
# tal cual vienen en el JSON, entre comillas.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID del Google Sheet (el valor entre /d/ y /edit en la URL de la planilla)
GOOGLE_SHEET_ID=
